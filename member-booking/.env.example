# Alchemy East Fremantle member booking channel.
#
# Copy to .env for local work, and set the real values in the Netlify UI for
# deployed environments. Never commit a filled-in copy: .env is gitignored and
# must stay that way. Nothing in this file is ever bundled into a client asset.

# --- Required in production -------------------------------------------------

# Postgres connection string.
#
# On Netlify you do not set this: Netlify DB provisions the database on deploy
# and provides NETLIFY_DATABASE_URL automatically, including a separate branch
# per deploy preview. Set DATABASE_URL only to point local work or CI at your
# own Postgres, where it takes precedence.
DATABASE_URL=

# Signing key for member and staff session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Hapana credentials. Two values, and the API wants both on every request as
# headers named accessID and siteID. Create a client named
# east-fremantle-member-channel at apidashboard.hapana.com so this channel can
# be revoked without touching any other integration.
#
# The key is bound to the site it was registered against, so these two belong
# together. GET /v2/site lists the sites a key can see, which is how to find
# the East Fremantle id. See docs/hapana-findings.md.
HAPANA_API_KEY=
HAPANA_SITE_ID=
HAPANA_BASE_URL=https://api.hapana.com

# Transactional email. console logs to the function log and delivers nothing,
# which is fine for local work and never acceptable in production.
#
#   smtp     send through a mailbox the business already owns. No new vendor,
#            no monthly cost, and mail comes from the address members already
#            recognise. Set SMTP_* below and leave EMAIL_API_KEY empty.
#   resend   or postmark: a transactional email vendor. Set EMAIL_API_KEY.
#   console  logs only.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Alchemy Saunas <bookings@alchemysaunas.com.au>

# SMTP, used when EMAIL_PROVIDER=smtp.
#
# For Google Workspace: SMTP_USER is the full address, SMTP_PASS is an app
# password (Google Account, Security, 2-Step Verification, App passwords), not
# the account password. An app password can be revoked on its own without
# touching the mailbox, so treat it like any other credential.
#
# Port 465 is implicit TLS, 587 upgrades with STARTTLS. Either works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# The public origin of this deployment. Used to build sign-in and waiver links.
PUBLIC_BASE_URL=http://localhost:8888

# Origins allowed to call the API: the Webflow site, plus local dev.
ALLOWED_ORIGINS=http://localhost:8888

DEFAULT_VENUE_ID=east-fremantle
